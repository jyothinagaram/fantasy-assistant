# Copy this file to .env and fill in your real values.
# Never commit the .env file itself.

# Your ESPN fantasy football league ID (found in your league's URL)
ESPN_LEAGUE_ID=

# ESPN authentication cookies (only needed for private leagues)
# See espn-api docs for how to find these in your browser's cookies
ESPN_S2=
ESPN_SWID=

# The fantasy season year, e.g. 2026
ESPN_SEASON=

# Your team's ID within the league (run check_connection.py to list all teams/IDs)
ESPN_TEAM_ID=

# Only needed when running somewhere other than your own computer.
# Set this and the page asks for a password before showing anything.
# Leave it empty at home and nothing changes.
APP_PASSWORD=
